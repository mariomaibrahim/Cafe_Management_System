<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane maxHeight="650.0" maxWidth="1100.0" minHeight="650.0" minWidth="1100.0" prefHeight="650.0" prefWidth="1100.0" stylesheets="@logindesign.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="aitpcafe.LoginController">
    
    <AnchorPane prefHeight="650.0" prefWidth="1100.0" styleClass="main-container">
        
        <AnchorPane fx:id="side_form" layoutX="0" layoutY="0" prefHeight="650.0" prefWidth="550.0" styleClass="side-panel">
            
            <VBox alignment="CENTER" layoutX="75" layoutY="150" prefWidth="400" spacing="25">
                
                <StackPane>
                    <Circle radius="60" styleClass="logo-circle" />
                    <FontIcon iconColor="white" iconLiteral="fas-coffee" iconSize="50" />
                </StackPane>
                
                <VBox alignment="CENTER" spacing="12">
                    <Label styleClass="welcome-title" text=" CAFE MANAGEMENT">
                        <graphic>
                            <FontIcon iconColor="white" iconLiteral="fas-utensils" iconSize="22" />
                        </graphic>
                    </Label>
                    <Line endX="100" startX="-100" styleClass="divider-line" />
                    <Label styleClass="welcome-subtitle" text="Welcome Back!" />
                    <Label styleClass="welcome-text" text="Your perfect café experience starts here" />
                </VBox>
                
            </VBox>
            
        </AnchorPane>

        <AnchorPane fx:id="si_loginform" layoutX="550.0" layoutY="0" prefHeight="650.0" prefWidth="550.0" styleClass="form-panel">
            
            <VBox alignment="CENTER" layoutX="100.0" layoutY="80.0" prefWidth="350" spacing="28">
                
                <VBox alignment="CENTER" spacing="12">
                    <StackPane prefWidth="350.0">
                        <Circle radius="32.0" styleClass="icon-circle" />
                        <FontIcon iconColor="WHITE" iconLiteral="fas-user-circle" iconSize="36" />
                    </StackPane>
                    <Label styleClass="form-title" text="SIGN IN" />
                    <Label styleClass="form-subtitle" text="Enter your credentials to continue" />
                </VBox>

                <VBox prefWidth="350" spacing="22">
                    
                    <VBox spacing="8">
                        <Label styleClass="field-label" text="Username" />
                        <HBox spacing="12" styleClass="input-container">
                            <StackPane styleClass="icon-wrapper">
                                <FontIcon iconColor="#2a777c" iconLiteral="fas-user" iconSize="16" />
                            </StackPane>
                            <TextField fx:id="si_username" promptText="Enter your username" styleClass="input-field" />
                        </HBox>
                    </VBox>

                    <VBox spacing="8">
                        <Label styleClass="field-label" text="Password" />
                        <HBox fx:id="si_passwordContainer" spacing="12" styleClass="input-container">
                            <StackPane styleClass="icon-wrapper">
                                <FontIcon iconColor="#2a777c" iconLiteral="fas-lock" iconSize="16" />
                            </StackPane>
                            <PasswordField fx:id="si_password" promptText="Enter your password" styleClass="input-field" />
                        </HBox>
                    </VBox>

                    <HBox alignment="CENTER_RIGHT">
                        <Hyperlink fx:id="si_forgotpass" onAction="#forgotPassBtn" styleClass="forgot-link">
                            <text> Forgot Password?</text>
                        </Hyperlink>
                    </HBox>

                    <Button fx:id="si_loginbtn" onAction="#loginBtn" prefHeight="48" prefWidth="350" styleClass="login-button">
                        <graphic>
                            <HBox alignment="CENTER" spacing="10">
                                <Label styleClass="button-text" text="LOGIN" />
                                <FontIcon iconColor="white" iconLiteral="fas-arrow-right" iconSize="15" />
                            </HBox>
                        </graphic>
                    </Button>
                    
                </VBox>

            </VBox>
        </AnchorPane>

        <AnchorPane fx:id="fp_forgotpassform" layoutX="550.0" layoutY="0" prefHeight="650.0" prefWidth="550.0" styleClass="form-panel" visible="false">
            
            <VBox alignment="CENTER" layoutX="100.0" layoutY="50.0" prefHeight="550.0" prefWidth="350.0" spacing="20">
                
                <VBox alignment="CENTER" spacing="10">
                    <StackPane>
                        <Circle radius="30" styleClass="icon-circle-reset" />
                        <FontIcon iconColor="WHITE" iconLiteral="fas-key" iconSize="30" />
                    </StackPane>
                    <Label styleClass="form-title-fp" text="RESET PASSWORD" />
                    <Label styleClass="form-subtitle" text="Fill in the details to reset your password" />
                </VBox>

                <VBox prefWidth="350" spacing="16">
                    
                    <VBox spacing="6">
                        <Label styleClass="field-label-fp" text="Username" />
                        <HBox spacing="10" styleClass="input-container-fp">
                            <StackPane styleClass="icon-wrapper-fp">
                                <FontIcon iconColor="#2a777c" iconLiteral="fas-user" iconSize="14" />
                            </StackPane>
                            <TextField fx:id="fp_username" promptText="Enter username" styleClass="input-field-fp" />
                        </HBox>
                    </VBox>

                    <VBox spacing="6">
                        <Label styleClass="field-label-fp" text="Security Question" />
                        <HBox spacing="10" styleClass="input-container-fp">
                            <StackPane styleClass="icon-wrapper-fp">
                                <FontIcon iconColor="#2a777c" iconLiteral="fas-question" iconSize="14" />
                            </StackPane>
                            <ComboBox fx:id="fp_question" prefWidth="290" promptText="Select a question" styleClass="combo-field" />
                        </HBox>
                    </VBox>

                    <VBox spacing="6">
                        <Label styleClass="field-label-fp" text="Answer" />
                        <HBox spacing="10" styleClass="input-container-fp">
                            <StackPane styleClass="icon-wrapper-fp">
                                <FontIcon iconColor="#2a777c" iconLiteral="fas-comment" iconSize="14" />
                            </StackPane>
                            <TextField fx:id="fp_answer" promptText="Your answer" styleClass="input-field-fp" />
                        </HBox>
                    </VBox>

                    <VBox spacing="6">
                        <Label styleClass="field-label-fp" text="New Password" />
                        <HBox fx:id="fp_passwordContainer" spacing="10" styleClass="input-container-fp">
                            <StackPane styleClass="icon-wrapper-fp">
                                <FontIcon iconColor="#2a777c" iconLiteral="fas-lock" iconSize="14" />
                            </StackPane>
                            <PasswordField fx:id="fp_newpassword" promptText="Enter new password" styleClass="input-field-fp" />
                        </HBox>
                    </VBox>

                    <HBox alignment="CENTER" spacing="12">
                        <Button fx:id="fp_backbtn" onAction="#backToLoginBtn" prefHeight="42" prefWidth="165" styleClass="back-button">
                            <graphic>
                                <HBox alignment="CENTER" spacing="6">
                                    <FontIcon iconColor="#2a777c" iconLiteral="fas-arrow-left" iconSize="13" />
                                    <Label styleClass="back-button-text" text="BACK" />
                                </HBox>
                            </graphic>
                        </Button>
                        <Button fx:id="fp_proceedbtn" onAction="#proceedBtn" prefHeight="42" prefWidth="165" styleClass="proceed-button">
                            <graphic>
                                <HBox alignment="CENTER" spacing="6">
                                    <Label styleClass="proceed-button-text" text="PROCEED" />
                                    <FontIcon iconColor="white" iconLiteral="fas-check" iconSize="13" />
                                </HBox>
                            </graphic>
                        </Button>
                    </HBox>
                    
                </VBox>

            </VBox>
        </AnchorPane>

    </AnchorPane>

</StackPane>
