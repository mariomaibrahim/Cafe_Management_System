                                 <graphic><FontIcon iconColor="WHITE" iconLiteral="fas-edit" iconSize="12" /></graphic>
                              </Button>
                              <Button fx:id="inventory_deleteBtn" onAction="#deleteProduct" prefWidth="110" styleClass="delete-btn" text="Delete">
                                 <graphic><FontIcon iconColor="WHITE" iconLiteral="fas-trash" iconSize="12" /></graphic>
                              </Button>
                              <Button fx:id="inventory_clearBtn" onAction="#clearFields" prefWidth="110" styleClass="clear-btn" text="Clear">
                                 <graphic><FontIcon iconColor="WHITE" iconLiteral="fas-times" iconSize="12" /></graphic>
                              </Button>
                           </HBox>
                        </VBox>
                     </VBox>
                  </ScrollPane>
               </children>
            </AnchorPane>
         </children>
      </AnchorPane>
   </children>
</StackPane>