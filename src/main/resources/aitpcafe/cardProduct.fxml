<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="280.0" prefWidth="220.0" stylesheets="@cardProduct.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="aitpcafe.CardProductController">
   <children>
      <VBox layoutX="-8.8" prefHeight="280.0" prefWidth="231.0" spacing="8" styleClass="Card" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="12" left="12" right="12" top="12" />
         </padding>
         <children>
            <!-- Image Container -->
            <AnchorPane prefHeight="150.0" prefWidth="196.0" styleClass="image-container">
               <children>
                  <ImageView fx:id="productimage" fitHeight="140.0" fitWidth="190.0" pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0" />
               </children>
            </AnchorPane>
            
            <!-- Product Name -->
            <Label fx:id="productName" alignment="TOP_LEFT" maxWidth="196.0" prefHeight="40.0" text="Product Name" wrapText="true">
               <font>
                  <Font name="Arial Bold" size="14.0" />
               </font>
            </Label>
            
            <!-- Product Price -->
            <Label fx:id="productPrice" styleClass="price-label" text="0.0 EGP">
               <font>
                  <Font name="Arial Bold" size="16.0" />
               </font>
            </Label>
            
            <!-- Action Buttons -->
            <HBox alignment="CENTER_LEFT" spacing="8">
               <children>
                  <Button fx:id="productBtn" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #27ae60;" styleClass="add-btn" stylesheets="@cardproduct.css" text="Add" />
                  <Spinner fx:id="productScroll" prefHeight="35.0" prefWidth="88.0" style="-fx-background-color: #D8F3DC;" stylesheets="@cardproduct.css" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
